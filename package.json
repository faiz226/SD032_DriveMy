{
  "name": "drivemy",
  "private": true,
  "version": "1.0.0",
  "description": "Bilingual (EN/BM) PWA for Malaysian learner drivers — JPJ KPP1 theory exam and practical driving test preparation",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:analyze": "tsc -b && vite build --mode analyze",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc -b --force",
    "clean": "node -e \"['dist','.vite','node_modules/.vite'].forEach(d => fs.rmSync(d, {recursive: true, force: true}))\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:circuit": "python docs/circuit-v2/check.py",
    "check:car": "node docs/v2-plan/physics/car-check.cjs node_modules/@dimforge/rapier3d-compat",
    "csp:hash": "node scripts/csp-hash.mjs",
    "audit:gate": "node scripts/audit-gate.mjs",
    "db:seed": "node scripts/ingest-questions.js",
    "db:upload-images": "node scripts/upload-images.js"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
