# =============================================================================
# DriveMy — environment template
#
#   cp .env.example .env.local
#
# .env.local is gitignored. Never commit real values.
#
# IMPORTANT: anything prefixed VITE_ is inlined into the JavaScript bundle at
# build time and is therefore PUBLIC. Only put values here that are safe to
# publish. A secret with a VITE_ prefix is a secret you have given away.
# =============================================================================

# ─── Required — client ───────────────────────────────────────────────────────

# Supabase project URL.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable ("anon") key. Public by design — row-level security, not
# this key, is what protects your data.
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# ─── Optional — client ───────────────────────────────────────────────────────

# Sentry DSN. Error tracking is skipped entirely when this is unset
# (src/main.tsx). If you set it, make sure the Sentry ingest host is present in
# the connect-src directive of the CSP in vercel.json, or every event is
# blocked by the browser before it leaves the page.
VITE_SENTRY_DSN=

# Override where the driving-simulator car model is fetched from. Defaults to
# /toyota-corolla-e170-2017.glb in public/. That file is gitignored and ~35 MB,
# so on a real deployment you almost certainly want to serve a compressed copy
# from object storage instead — see docs/3D_ASSETS.md.
VITE_CAR_MODEL_URL=

# Cloudflare Turnstile site key. The captcha widget renders only when this is
# set, and the token is forwarded to Supabase on sign-in, sign-up, password
# reset and confirmation resend. If you set it, you must also set the matching
# secret on the hosted Supabase project (Authentication → Attack Protection),
# otherwise Supabase will not verify the token.
VITE_TURNSTILE_SITE_KEY=

# ─── Server-side only — NEVER prefix these with VITE_ ────────────────────────

# DeepSeek API key — used by the `graphify` codebase-analysis CLI, NOT by the
# application. Kept here because graphify reads .env.local. Do not add a VITE_
# prefix: that would inline it into the client bundle and publish it.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Supabase service-role key. Bypasses ALL row-level security.
# Used only by the local seeding scripts (npm run db:seed, db:upload-images).
# It must never appear in the client bundle. Leave unset unless you are seeding.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Build-time only — set these in Vercel, not in .env.local ────────────────

# Sentry sourcemap upload. All three must be set or upload is skipped entirely
# (local and fork builds are unaffected). Without upload, every production
# stack trace is unreadable minified output AND the .map files ship publicly
# in dist/ — the worst of both worlds.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
